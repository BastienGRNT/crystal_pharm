# En local : copier ce fichier tel quel dans `.env` (cp .env.example .env), tout marche sans rien changer.
# Les secrets ci-dessous ne valent que pour le dev : jamais en prod.

# Postgres (Docker, `make start`)
POSTGRES_USER=crystal_pharm
POSTGRES_PASSWORD=dev
POSTGRES_DB=crystal_pharm
DATABASE_URL=postgres://crystal_pharm:dev@localhost:5445/crystal_pharm

# Le domaine de chaque app (en dev : localhost et son port)
PHARMACY_URL=http://localhost:5173
GROUP_URL=http://groupement.localhost:5174
ADMIN_URL=http://admin.localhost:5175
# L'aperçu des sites (app/site derrière Caddy), affiché dans site-manager
SITE_PREVIEW_URL=http://apercu.localhost:8080
# Signe les adresses des images de l'aperçu (pharmacy/host signe, app/site vérifie) ; en prod : openssl rand -base64 32
SITE_PREVIEW_MEDIA_SECRET=dev-only-site-preview-media-secret-change-me-in-production
# Les sites publics : celui d'un Tenant est à http://<son adresse>.site.localhost:8080, choisie dans site-manager
SITE_URL=http://site.localhost:8080
# Prouve à pharmacy/host que la question « à qui est cette adresse ? » vient de Caddy ; en prod : openssl rand -base64 32
SITE_GATEWAY_TOKEN=dev-only-site-gateway-token-change-me-in-production

# Les comptes clients (pharmacy, group) ; en prod : openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-in-production
# La Platform (admin), un secret différent ; en prod : openssl rand -base64 32
PLATFORM_AUTH_SECRET=dev-only-platform-auth-secret-change-me-in-production
# Les seuls emails qui peuvent créer un compte admin, séparés par des virgules
PLATFORM_ADMIN_EMAILS=admin@crystal-pharm.local

# L'API C# (app/api, `make api`), jamais exposée à Internet : appelée par le serveur de pharmacy/host
API_URL=http://localhost:5158
ConnectionStrings__Booking=Host=localhost;Port=5445;Database=crystal_pharm;Username=crystal_pharm;Password=dev
# Le JWT court des Managers : le JWKS interne de pharmacy/host, son émetteur et son audience
ManagerJwt__JwksUrl=http://localhost:5173/api/auth/jwks
ManagerJwt__Issuer=http://localhost:5173
ManagerJwt__Audience=crystal-pharm-api

# Facultatif en dev : sans valeur, chacun a son comportement de dev.
# Sans clé, aucun email ne part : ils arrivent dans la boîte de l'outil de dev.
# RESEND_API_KEY=
# EMAIL_SENDER=Crystal Pharm <bonjour@crystal-pharm.fr>
# Sans clé, le faux PaymentProvider sert de paiement.
# STRIPE_SECRET_KEY=
# Sans valeur, les fichiers vont dans `.storage/` à la racine.
# FILE_STORAGE_DIRECTORY=
# Les mentions de l'émetteur sur les factures (adresse : lignes séparées par |)
# INVOICE_ISSUER_NAME=Crystal Pharm
# INVOICE_ISSUER_ADDRESS=
# INVOICE_ISSUER_SIREN=
# INVOICE_ISSUER_VAT_NUMBER=
