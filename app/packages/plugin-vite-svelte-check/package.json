		"build": "tsup src/index.ts --format esm --dts --out-dir dist"
	},
	"peerDependencies": {
		"vite": "^6.0.0",
		"svelte-check": "^4.0.0"
	},
	"devDependencies": {
		"tsup": "^8.3.0",
		"typescript": "^5.7.0",
		"@types/node": "^22.0.0",
		"vite": "^6.0.0"
	}
}
