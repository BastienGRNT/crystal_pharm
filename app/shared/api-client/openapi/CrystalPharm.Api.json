      "NewAppointmentDto": {
        "required": [
          "employeeId",
          "day",
          "startTime",
          "endTime",
          "patientName",
          "patientPhone",
          "reason"
        ],
        "type": "object",
        "properties": {
          "employeeId": {
            "type": "string",
            "format": "uuid"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "endTime": {
            "type": "string",
