{
	"name": "@crystal-pharm/billing-db",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.server.ts",
		"./domain": "./src/domain.ts",
		"./tables": "./src/database/billingTables.ts"
	},
	"scripts": {
		"check": "tsc --project tsconfig.json",
		"test": "vitest run --exclude '**/*.integration.test.ts'",
		"test:integration": "vitest run integration",
		"generate-migration": "drizzle-kit generate",
		"migrate": "drizzle-kit migrate",
		"rebuild-tool-access": "node --import ./src/maintenance/registerTypeScriptExtensionResolution.ts src/maintenance/rebuildToolAccessAfterMigration.script.ts"
	},
	"dependencies": {
		"@crystal-pharm/auth": "workspace:*",
		"@crystal-pharm/email": "workspace:*",
		"@crystal-pharm/group-db": "workspace:*",
		"@crystal-pharm/pharmacy-db": "workspace:*",
		"drizzle-orm": "^0.45.4",
		"pdf-lib": "^1.17.1",
		"postgres": "^3.4.9",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"drizzle-kit": "^0.31.11",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
