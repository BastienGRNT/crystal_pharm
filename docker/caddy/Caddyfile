# La passerelle de dev : le rôle que tiendra la passerelle de prod devant `app/site`.
# Elle tourne dans Docker : `host.docker.internal` est la machine où tourne `pnpm dev`.
# Elle ne sait pas quel Tenant est servi : `app/site` le résout depuis l'adresse demandée.
# Aucun journal des requêtes : une adresse demandée peut dire qu'une personne cherche un soin.
{
	auto_https off
	admin off
}

# Le site d'un Tenant : http://<son adresse>.site.localhost:8080, choisie dans site-manager.
http://*.site.localhost:8080 {
	route {
		request_header -X-Tenant-Id

		@preview path /__preview /__preview/*
		respond @preview "Page introuvable." 404

		reverse_proxy host.docker.internal:5177
	}
}

# L'aperçu de site-manager : jamais de Tenant, les données arrivent par postMessage.
http://apercu.localhost:8080 {
	reverse_proxy host.docker.internal:5177 {
		header_up -X-Tenant-Id
	}
}
