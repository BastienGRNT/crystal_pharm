# Le VPS du C# en dev : l'API (`make api`), qui trouve ce fichier en remontant depuis son dossier.
# Valeurs de dev, publiques : jamais en prod (cf. env/production/api.env.example).
# Une variable posée dans le shell l'emporte.

# ─── Le Postgres HDS (Docker, port 5446) ──────────────────────────────────────
# L'API migre par le propriétaire des schémas, puis tourne avec un rôle ordinaire, soumis à la RLS.
ConnectionStrings__HealthMigrations=Host=localhost;Port=5446;Database=crystal_pharm_health;Username=crystal_pharm_health;Password=dev
ConnectionStrings__Booking=Host=localhost;Port=5446;Database=crystal_pharm_health;Username=crystal_pharm_api;Password=dev
ConnectionStrings__Prescriptions=Host=localhost;Port=5446;Database=crystal_pharm_health;Username=crystal_pharm_api;Password=dev

# ─── Le stockage objet HDS (Docker, port 8334) : les fichiers des ordonnances ─
# Le navigateur y dépose et y lit par les liens pré-signés de l'API, la seule à avoir une clé.
PrescriptionStorage__ServiceUrl=http://localhost:8334
PrescriptionStorage__BucketName=prescriptions
PrescriptionStorage__AccessKeyId=dev-health-api
PrescriptionStorage__SecretAccessKey=dev-health-api-secret-not-for-production

# ─── Ses deux appelants ───────────────────────────────────────────────────────
# Le service `site` : la même clé que dans web.env
SiteService__ApiKey=dev-only-site-service-key-change-me-in-production
# Les TenantMembers : le JWT court de pharmacy, vérifié par son JWKS
ManagerJwt__JwksUrl=http://localhost:5173/api/auth/jwks
ManagerJwt__Issuer=http://localhost:5173
ManagerJwt__Audience=crystal-pharm-api
