# Le VPS du Postgres du Node en dev : le conteneur `postgres` de compose.yml (port 5445).
# Valeurs de dev, publiques : jamais en prod (cf. env/production/database.env.example).
# Les apps le joignent par DATABASE_URL (web.env) : à changer ensemble.
POSTGRES_USER=crystal_pharm
POSTGRES_PASSWORD=dev
POSTGRES_DB=crystal_pharm
