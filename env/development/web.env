# Le VPS web en dev : les apps Node (pharmacy, group, admin, site), leurs migrations et leurs tests.
# Lu tel quel par `pnpm dev`, `make migrate` et les tests : rien à copier. Valeurs de dev, publiques :
# jamais en prod (cf. env/production/web.env.example). Une variable posée dans le shell l'emporte.

# Sans cette variable, les apps se comportent comme en production (secrets d'exemple refusés au démarrage).
APP_ENV=development

# ─── Les adresses ─────────────────────────────────────────────────────────────
PHARMACY_URL=http://localhost:5173
GROUP_URL=http://groupement.localhost:5174
ADMIN_URL=http://admin.localhost:5175
# Les sites publics, derrière Caddy : celui d'un Tenant est à http://<son adresse>.site.localhost:8080
SITE_URL=http://site.localhost:8080
# L'aperçu des sites, affiché dans site-manager
SITE_PREVIEW_URL=http://apercu.localhost:8080

# ─── Le Postgres du Node (env/development/database.env) ───────────────────────
DATABASE_URL=postgres://crystal_pharm:dev@localhost:5445/crystal_pharm

# ─── L'API C# (env/development/api.env), appelée par pharmacy et site ─────────
API_URL=http://localhost:5158
# L'identité de service de `site` : la même que dans api.env
SiteService__ApiKey=dev-only-site-service-key-change-me-in-production

# ─── Les secrets ──────────────────────────────────────────────────────────────
# Les comptes clients (pharmacy, group)
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-in-production
# La Platform (admin), et les seuls emails qui peuvent y créer un compte
PLATFORM_AUTH_SECRET=dev-only-platform-auth-secret-change-me-in-production
PLATFORM_ADMIN_EMAILS=admin@crystal-pharm.local
# Les images de l'aperçu : signées par pharmacy, vérifiées par site
SITE_PREVIEW_MEDIA_SECRET=dev-only-site-preview-media-secret-change-me-in-production

# ─── Le stockage objet des fichiers (R2 en prod) : SeaweedFS, port 8333 ───────
FILE_STORAGE_ENDPOINT=http://localhost:8333
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=files
FILE_STORAGE_ACCESS_KEY_ID=dev-files-node
FILE_STORAGE_SECRET_ACCESS_KEY=dev-files-node-secret-not-for-production

# ─── Les emails (Scaleway TEM en prod) ────────────────────────────────────────
# Avec APP_ENV=development, rien ne part : tout arrive dans Mailpit (http://localhost:8025), lu par l'outil de dev.
DEVELOPMENT_MAILBOX_URL=http://localhost:8025
DEVELOPMENT_MAILBOX_SMTP_URL=smtp://localhost:1025
