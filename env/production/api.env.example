# Le VPS du C# (api : Booking, Prescriptions), seul à joindre l'hébergeur HDS.
# Le modèle des variables à renseigner dans Forge, jamais dans un fichier commité. Le plan : docs/architecture.md.

# ASPNETCORE_ENVIRONMENT=Production   # `Development` seulement sur le serveur de dev : endpoints de dev, Swagger

# ─── Le Postgres HDS managé : chaînes Npgsql, en TLS vérifié ──────────────────
# Le rôle crystal_pharm_api se crée une fois, par le propriétaire (docs/architecture.md).
ConnectionStrings__HealthMigrations=Host=<hôte HDS>;Port=5432;Database=<base>;Username=<propriétaire>;Password=<…>;SSL Mode=VerifyFull
ConnectionStrings__Booking=Host=<hôte HDS>;Port=5432;Database=<base>;Username=crystal_pharm_api;Password=<…>;SSL Mode=VerifyFull
ConnectionStrings__Prescriptions=Host=<hôte HDS>;Port=5432;Database=<base>;Username=crystal_pharm_api;Password=<…>;SSL Mode=VerifyFull

# ─── Le stockage objet HDS (les fichiers des ordonnances) ─────────────────────
# Une clé limitée à ce bucket ; son CORS autorise PUT et GET depuis les sites (docs/architecture.md).
PrescriptionStorage__ServiceUrl=https://<point d'accès S3 HDS>
# PrescriptionStorage__PublicServiceUrl=   # vide = le même ; sinon l'adresse que voit le navigateur
# PrescriptionStorage__Region=
PrescriptionStorage__BucketName=crystal-pharm-prescriptions
PrescriptionStorage__AccessKeyId=
PrescriptionStorage__SecretAccessKey=

# ─── Ses deux appelants ───────────────────────────────────────────────────────
# La même que dans web.env
SiteService__ApiKey=
# PHARMACY_URL de web.env
ManagerJwt__Issuer=https://pharmacie.example.fr
