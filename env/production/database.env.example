# Le VPS du Postgres du Node (postgres, backup).
# Le modèle des variables à renseigner dans Forge, jamais dans un fichier commité. Le plan : docs/architecture.md.

# ─── Le Postgres du Node ──────────────────────────────────────────────────────
POSTGRES_USER=crystal_pharm
# openssl rand -hex 24 : en hexadécimal, il passe dans une URL
POSTGRES_PASSWORD=
POSTGRES_DB=crystal_pharm

# ─── Les sauvegardes : la base et les fichiers, chiffrés ; jamais de donnée de santé ──
# Le bucket des fichiers (les mêmes valeurs que dans web.env), lu par une clé en lecture seule
FILE_STORAGE_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
FILE_STORAGE_REGION=auto
FILE_STORAGE_BUCKET=crystal-pharm-files
BACKUP_FILES_ACCESS_KEY_ID=
BACKUP_FILES_SECRET_ACCESS_KEY=
# Le stockage des sauvegardes (un autre fournisseur), une clé limitée à son bucket
BACKUP_STORAGE_ENDPOINT=https://<point d'accès S3>
BACKUP_STORAGE_REGION=auto
BACKUP_STORAGE_BUCKET=crystal-pharm-backups
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=
# `develop` sur le serveur de dev s'il partage le bucket
BACKUP_PREFIX=production
# openssl rand -base64 32 ; sans lui les sauvegardes sont illisibles : à garder aussi hors du serveur
BACKUP_ENCRYPTION_PASSWORD=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=30
