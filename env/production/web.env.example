# Le VPS web (Caddy + les apps Node : pharmacy, group, admin, site, migrate).
# Le modèle des variables à renseigner dans Forge, jamais dans un fichier commité. Le plan : docs/architecture.md.
# Chaque serveur (prod = main, dev = develop) a son propre jeu de valeurs, sa base et ses buckets.

# `development` seulement sur le serveur de dev : outil de dev, boîte Mailpit, faux paiement
APP_ENV=production
# COMPOSE_PROFILES=development-mailbox   # seulement sur le serveur de dev : lance Mailpit
# GATEWAY_PORT=8080                 # le port publié par Caddy, derrière le proxy HTTPS

# ─── Les adresses publiques (https, sans « / » final) ─────────────────────────
PHARMACY_URL=https://pharmacie.example.fr
GROUP_URL=https://groupement.example.fr
ADMIN_URL=https://admin.example.fr
# Le site d'un Tenant : https://<adresse>.site.example.fr
SITE_URL=https://site.example.fr
SITE_PREVIEW_URL=https://apercu.example.fr

# ─── Le Postgres du Node (database.env) ───────────────────────────────────────
# Sur un serveur qui porte aussi la base : l'hôte `postgres` ; sinon, l'adresse privée de son VPS.
DATABASE_URL=postgres://crystal_pharm:<POSTGRES_PASSWORD de database.env>@postgres:5432/crystal_pharm

# ─── Les secrets : openssl rand -base64 32, un par variable ───────────────────
BETTER_AUTH_SECRET=
PLATFORM_AUTH_SECRET=
SITE_PREVIEW_MEDIA_SECRET=
# La même que dans api.env
SiteService__ApiKey=
PLATFORM_ADMIN_EMAILS=vous@example.fr

# ─── Le stockage objet des fichiers (R2) : une clé limitée à ce bucket ────────
FILE_STORAGE_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
FILE_STORAGE_REGION=auto
FILE_STORAGE_BUCKET=crystal-pharm-files
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=

# ─── Les emails (Scaleway TEM, en TLS) ────────────────────────────────────────
# Identifiant = l'id du projet, mot de passe = une clé API encodée pour une URL.
SMTP_URL=smtp://<id du projet>:<clé API>@smtp.tem.scaleway.com:587
# Un domaine vérifié chez TEM
EMAIL_SENDER=Crystal Pharm <bonjour@example.fr>

# ─── Facultatif ───────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=                # sans clé : le faux PaymentProvider (toujours lui avec APP_ENV=development)
# INVOICE_ISSUER_NAME=Crystal Pharm
# INVOICE_ISSUER_ADDRESS=           # lignes séparées par |
# INVOICE_ISSUER_SIREN=
# INVOICE_ISSUER_VAT_NUMBER=
