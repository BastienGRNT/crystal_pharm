# La prod simulée : le VPS du C#, comme env/production/api.env.example.
# Valeurs de simulation, publiques : jamais sur un serveur.
ASPNETCORE_ENVIRONMENT=Production

# Postgres HDS managé → health-postgres (mots de passe : providers.env)
ConnectionStrings__HealthMigrations=Host=health-postgres;Port=5432;Database=crystal_pharm_health;Username=crystal_pharm_health;Password=simulation
ConnectionStrings__Booking=Host=health-postgres;Port=5432;Database=crystal_pharm_health;Username=crystal_pharm_api;Password=simulation-api
ConnectionStrings__Prescriptions=Host=health-postgres;Port=5432;Database=crystal_pharm_health;Username=crystal_pharm_api;Password=simulation-api

# Stockage objet HDS → health-object-storage (cf. docker/object-storage/health.s3.json), vu par le navigateur sur localhost:8335
PrescriptionStorage__ServiceUrl=http://health-object-storage:8333
PrescriptionStorage__PublicServiceUrl=http://localhost:8335
PrescriptionStorage__BucketName=prescriptions
PrescriptionStorage__AccessKeyId=dev-health-api
PrescriptionStorage__SecretAccessKey=dev-health-api-secret-not-for-production

SiteService__ApiKey=simulation-site-service-key-0123456789abcdef
ManagerJwt__Issuer=http://pharmacie.localhost:8090
