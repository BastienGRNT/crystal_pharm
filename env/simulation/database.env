# La prod simulée : le VPS du Postgres du Node, comme env/production/database.env.example.
# Valeurs de simulation, publiques : jamais sur un serveur.
POSTGRES_USER=crystal_pharm
POSTGRES_PASSWORD=simulation
POSTGRES_DB=crystal_pharm

# R2 → object-storage (cf. docker/object-storage/files.s3.json), lu par une clé en lecture seule
FILE_STORAGE_ENDPOINT=http://object-storage:8333
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=files
BACKUP_FILES_ACCESS_KEY_ID=dev-files-backup
BACKUP_FILES_SECRET_ACCESS_KEY=dev-files-backup-secret-not-for-production
# Le stockage des sauvegardes → backup-object-storage (cf. docker/object-storage/backups.s3.json)
BACKUP_STORAGE_ENDPOINT=http://backup-object-storage:8333
BACKUP_STORAGE_REGION=us-east-1
BACKUP_STORAGE_BUCKET=backups
BACKUP_STORAGE_ACCESS_KEY_ID=dev-backups-writer
BACKUP_STORAGE_SECRET_ACCESS_KEY=dev-backups-writer-secret-not-for-production
BACKUP_PREFIX=simulation
BACKUP_ENCRYPTION_PASSWORD=simulation-backup-encryption-password
