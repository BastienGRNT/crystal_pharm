# La prod simulée : le VPS web, comme env/production/web.env.example.
# Valeurs de simulation, publiques : jamais sur un serveur.
APP_ENV=production
GATEWAY_PORT=8090

PHARMACY_URL=http://pharmacie.localhost:8090
GROUP_URL=http://groupement.localhost:8090
ADMIN_URL=http://admin.localhost:8090
SITE_URL=http://site.localhost:8090
SITE_PREVIEW_URL=http://apercu.localhost:8090

DATABASE_URL=postgres://crystal_pharm:simulation@postgres:5432/crystal_pharm

BETTER_AUTH_SECRET=simulation-better-auth-secret-0123456789abcdef
PLATFORM_AUTH_SECRET=simulation-platform-auth-secret-0123456789abcdef
SITE_PREVIEW_MEDIA_SECRET=simulation-site-preview-media-secret-0123456789
SiteService__ApiKey=simulation-site-service-key-0123456789abcdef
PLATFORM_ADMIN_EMAILS=admin@crystal-pharm.local

# R2 → object-storage (cf. docker/object-storage/files.s3.json)
FILE_STORAGE_ENDPOINT=http://object-storage:8333
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=files
FILE_STORAGE_ACCESS_KEY_ID=dev-files-node
FILE_STORAGE_SECRET_ACCESS_KEY=dev-files-node-secret-not-for-production

# Scaleway TEM → Mailpit (http://localhost:8026)
SMTP_URL=smtp://simulation:simulation@mailpit:1025
SMTP_ALLOW_PLAIN_TEXT=true
